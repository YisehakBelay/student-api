# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Required ──────────────────────────────────────────────────────────────────
# Secret used to sign JWT tokens. Use a long random string (32+ chars).
JWT_SECRET=replace_with_a_long_random_secret_string

# ── Optional (shown with defaults) ───────────────────────────────────────────
# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/studentDB

# Server port
PORT=5000

# JWT expiry (any value accepted by jsonwebtoken, e.g. 7d, 24h, 60m)
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed CORS origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Set to "production" to enable combined morgan logs and hide stack traces in errors
NODE_ENV=development
